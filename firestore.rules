rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(resource) {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /programs/{programId} {
      allow read: if isOwner(resource);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource);

      match /syllabi/{syllabusId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/programs/$(programId)).data.ownerUid == request.auth.uid;
        allow write: if signedIn()
          && get(/databases/$(database)/documents/programs/$(programId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
