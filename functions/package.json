{
  "name": "dchp-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for DCHP syllabus generator",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.5.4"
  },
  "private": true
}
